{
  "name": "Gone Done",
  "short_name": "Gone Done",
  "description": "Онлайн-платформер про насекомых на крышах",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "index.apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "index.icon.png", "sizes": "128x128", "type": "image/png", "purpose": "any" }
  ]
}
